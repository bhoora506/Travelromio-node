generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model cache {
  key        String @id @db.VarChar(255)
  value      String @db.MediumText
  expiration BigInt

  @@index([expiration], map: "cache_expiration_index")
}

model cache_locks {
  key        String @id @db.VarChar(255)
  owner      String @db.VarChar(255)
  expiration BigInt

  @@index([expiration], map: "cache_locks_expiration_index")
}

model connection_requests {
  id                                            BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  requester_id                                  BigInt    @db.UnsignedBigInt
  recipient_id                                  BigInt    @db.UnsignedBigInt
  status                                        String    @default("pending") @db.VarChar(20)
  created_at                                    DateTime? @db.Timestamp(0)
  updated_at                                    DateTime? @db.Timestamp(0)
  users_connection_requests_recipient_idTousers users     @relation("connection_requests_recipient_idTousers", fields: [recipient_id], references: [id], onUpdate: NoAction, map: "connection_requests_recipient_id_foreign")
  users_connection_requests_requester_idTousers users     @relation("connection_requests_requester_idTousers", fields: [requester_id], references: [id], onUpdate: NoAction, map: "connection_requests_requester_id_foreign")

  @@index([recipient_id], map: "connection_requests_recipient_id_index")
  @@index([recipient_id, status], map: "connection_requests_recipient_id_status_index")
  @@index([requester_id], map: "connection_requests_requester_id_index")
  @@index([requester_id, status], map: "connection_requests_requester_id_status_index")
  @@index([status], map: "connection_requests_status_index")
}

model conversations {
  id                                      BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  requester_id                            BigInt     @db.UnsignedBigInt
  recipient_id                            BigInt     @db.UnsignedBigInt
  created_at                              DateTime?  @db.Timestamp(0)
  updated_at                              DateTime?  @db.Timestamp(0)
  users_conversations_recipient_idTousers users      @relation("conversations_recipient_idTousers", fields: [recipient_id], references: [id], onUpdate: NoAction, map: "conversations_recipient_id_foreign")
  users_conversations_requester_idTousers users      @relation("conversations_requester_idTousers", fields: [requester_id], references: [id], onUpdate: NoAction, map: "conversations_requester_id_foreign")
  messages                                messages[]

  @@unique([requester_id, recipient_id], map: "conversations_requester_id_recipient_id_unique")
  @@index([recipient_id], map: "conversations_recipient_id_index")
  @@index([requester_id], map: "conversations_requester_id_index")
}

model failed_jobs {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  uuid       String   @unique(map: "failed_jobs_uuid_unique") @db.VarChar(255)
  connection String   @db.VarChar(255)
  queue      String   @db.VarChar(255)
  payload    String   @db.LongText
  exception  String   @db.LongText
  failed_at  DateTime @default(now()) @db.Timestamp(0)

  @@index([connection, queue, failed_at], map: "failed_jobs_connection_queue_failed_at_index")
}

model interests {
  id             BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  name           String           @unique(map: "interests_name_unique") @db.VarChar(100)
  slug           String           @unique(map: "interests_slug_unique") @db.VarChar(100)
  created_at     DateTime?        @db.Timestamp(0)
  updated_at     DateTime?        @db.Timestamp(0)
  trip_interests trip_interests[]
  user_interests user_interests[]
}

model job_batches {
  id             String  @id @db.VarChar(255)
  name           String  @db.VarChar(255)
  total_jobs     Int
  pending_jobs   Int
  failed_jobs    Int
  failed_job_ids String  @db.LongText
  options        String? @db.MediumText
  cancelled_at   Int?
  created_at     Int
  finished_at    Int?
}

model jobs {
  id           BigInt @id @default(autoincrement()) @db.UnsignedBigInt
  queue        String @db.VarChar(255)
  payload      String @db.LongText
  attempts     Int    @db.UnsignedSmallInt
  reserved_at  Int?   @db.UnsignedInt
  available_at Int    @db.UnsignedInt
  created_at   Int    @db.UnsignedInt

  @@index([queue], map: "jobs_queue_index")
}

model messages {
  id              BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  conversation_id BigInt        @db.UnsignedBigInt
  sender_id       BigInt        @db.UnsignedBigInt
  body            String        @db.Text
  read_at         DateTime?     @db.Timestamp(0)
  created_at      DateTime?     @db.Timestamp(0)
  updated_at      DateTime?     @db.Timestamp(0)
  conversations   conversations @relation(fields: [conversation_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "messages_conversation_id_foreign")
  users           users         @relation(fields: [sender_id], references: [id], onUpdate: NoAction, map: "messages_sender_id_foreign")

  @@index([conversation_id, created_at], map: "messages_conversation_id_created_at_index")
  @@index([sender_id], map: "messages_sender_id_index")
}

model migrations {
  id        Int    @id @default(autoincrement()) @db.UnsignedInt
  migration String @db.VarChar(255)
  batch     Int
}

model password_reset_tokens {
  email      String    @id @db.VarChar(255)
  token      String    @db.VarChar(255)
  created_at DateTime? @db.Timestamp(0)
}

model personal_access_tokens {
  id             BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  tokenable_type String    @db.VarChar(255)
  tokenable_id   BigInt    @db.UnsignedBigInt
  name           String    @db.Text
  token          String    @unique(map: "personal_access_tokens_token_unique") @db.VarChar(64)
  abilities      String?   @db.Text
  last_used_at   DateTime? @db.Timestamp(0)
  expires_at     DateTime? @db.Timestamp(0)
  created_at     DateTime? @db.Timestamp(0)
  updated_at     DateTime? @db.Timestamp(0)

  @@index([expires_at], map: "personal_access_tokens_expires_at_index")
  @@index([tokenable_type, tokenable_id], map: "personal_access_tokens_tokenable_type_tokenable_id_index")
}

model preferred_destinations {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  user_id     BigInt    @db.UnsignedBigInt
  destination String    @db.VarChar(200)
  place_id    String?   @db.VarChar(100)
  latitude    Decimal?  @db.Decimal(10, 7)
  longitude   Decimal?  @db.Decimal(10, 7)
  created_at  DateTime? @db.Timestamp(0)
  updated_at  DateTime? @db.Timestamp(0)
  users       users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "preferred_destinations_user_id_foreign")

  @@index([place_id], map: "preferred_destinations_place_id_index")
  @@index([user_id], map: "preferred_destinations_user_id_index")
}

model sessions {
  id            String  @id @db.VarChar(255)
  user_id       BigInt? @db.UnsignedBigInt
  ip_address    String? @db.VarChar(45)
  user_agent    String? @db.Text
  payload       String  @db.LongText
  last_activity Int

  @@index([last_activity], map: "sessions_last_activity_index")
  @@index([user_id], map: "sessions_user_id_index")
}

model travel_availabilities {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  user_id    BigInt    @db.UnsignedBigInt
  start_date DateTime  @db.Date
  end_date   DateTime  @db.Date
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "travel_availabilities_user_id_foreign")

  @@index([end_date], map: "travel_availabilities_end_date_index")
  @@index([start_date], map: "travel_availabilities_start_date_index")
  @@index([user_id], map: "travel_availabilities_user_id_index")
}

model trip_interests {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  trip_id     BigInt    @db.UnsignedBigInt
  interest_id BigInt    @db.UnsignedBigInt
  created_at  DateTime? @db.Timestamp(0)
  updated_at  DateTime? @db.Timestamp(0)
  interests   interests @relation(fields: [interest_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "trip_interests_interest_id_foreign")
  trips       trips     @relation(fields: [trip_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "trip_interests_trip_id_foreign")

  @@unique([trip_id, interest_id], map: "trip_interests_trip_id_interest_id_unique")
  @@index([interest_id], map: "trip_interests_interest_id_foreign")
}

model trip_join_requests {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  trip_id    BigInt    @db.UnsignedBigInt
  user_id    BigInt    @db.UnsignedBigInt
  status     String    @default("pending") @db.VarChar(20)
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
  trips      trips     @relation(fields: [trip_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "trip_join_requests_trip_id_foreign")
  users      users     @relation(fields: [user_id], references: [id], onUpdate: NoAction, map: "trip_join_requests_user_id_foreign")

  @@index([status], map: "trip_join_requests_status_index")
  @@index([trip_id], map: "trip_join_requests_trip_id_index")
  @@index([trip_id, status], map: "trip_join_requests_trip_id_status_index")
  @@index([user_id], map: "trip_join_requests_user_id_index")
}

model trip_members {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  trip_id    BigInt    @db.UnsignedBigInt
  user_id    BigInt    @db.UnsignedBigInt
  role       String    @default("member") @db.VarChar(20)
  status     String    @default("active") @db.VarChar(20)
  joined_at  DateTime? @db.Timestamp(0)
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
  trips      trips     @relation(fields: [trip_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "trip_members_trip_id_foreign")
  users      users     @relation(fields: [user_id], references: [id], onUpdate: NoAction, map: "trip_members_user_id_foreign")

  @@unique([trip_id, user_id], map: "trip_members_trip_id_user_id_unique")
  @@index([role], map: "trip_members_role_index")
  @@index([status], map: "trip_members_status_index")
  @@index([trip_id], map: "trip_members_trip_id_index")
  @@index([user_id], map: "trip_members_user_id_index")
}

model trips {
  id                 BigInt               @id @default(autoincrement()) @db.UnsignedBigInt
  user_id            BigInt               @db.UnsignedBigInt
  title              String               @db.VarChar(200)
  destination        String               @db.VarChar(200)
  place_id           String?              @db.VarChar(100)
  latitude           Decimal?             @db.Decimal(10, 7)
  longitude          Decimal?             @db.Decimal(10, 7)
  start_date         DateTime             @db.Date
  end_date           DateTime             @db.Date
  budget_min         Decimal?             @db.Decimal(12, 2)
  budget_max         Decimal?             @db.Decimal(12, 2)
  trip_type          String               @db.VarChar(50)
  description        String?              @db.Text
  image_path         String?              @db.VarChar(255)
  max_members        Int                  @default(2) @db.UnsignedTinyInt
  status             String               @default("draft") @db.VarChar(20)
  created_at         DateTime?            @db.Timestamp(0)
  updated_at         DateTime?            @db.Timestamp(0)
  trip_interests     trip_interests[]
  trip_join_requests trip_join_requests[]
  trip_members       trip_members[]
  users              users                @relation(fields: [user_id], references: [id], onUpdate: NoAction, map: "trips_user_id_foreign")

  @@index([destination], map: "trips_destination_index")
  @@index([end_date], map: "trips_end_date_index")
  @@index([start_date], map: "trips_start_date_index")
  @@index([status], map: "trips_status_index")
  @@index([status, start_date, end_date], map: "trips_status_start_date_end_date_index")
  @@index([trip_type], map: "trips_trip_type_index")
  @@index([user_id], map: "trips_user_id_index")
}

model user_devices {
  id           BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  user_id      BigInt    @db.UnsignedBigInt
  fcm_token    String    @unique(map: "user_devices_fcm_token_unique") @db.VarChar(255)
  platform     String    @db.VarChar(10)
  last_used_at DateTime? @db.Timestamp(0)
  created_at   DateTime? @db.Timestamp(0)
  updated_at   DateTime? @db.Timestamp(0)
  users        users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "user_devices_user_id_foreign")

  @@index([user_id], map: "user_devices_user_id_index")
}

model user_interests {
  user_id     BigInt    @db.UnsignedBigInt
  interest_id BigInt    @db.UnsignedBigInt
  created_at  DateTime? @db.Timestamp(0)
  updated_at  DateTime? @db.Timestamp(0)
  interests   interests @relation(fields: [interest_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "user_interests_interest_id_foreign")
  users       users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "user_interests_user_id_foreign")

  @@id([user_id, interest_id])
  @@index([interest_id], map: "user_interests_interest_id_foreign")
}

model user_profiles {
  id                   BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  user_id              BigInt    @unique(map: "user_profiles_user_id_unique") @db.UnsignedBigInt
  profile_photo_path   String?   @db.VarChar(255)
  bio                  String?   @db.Text
  city                 String?   @db.VarChar(100)
  country              String?   @db.VarChar(100)
  languages            Json?
  travel_style         String?   @db.VarChar(50)
  preferred_budget_min Decimal?  @db.Decimal(12, 2)
  preferred_budget_max Decimal?  @db.Decimal(12, 2)
  is_discoverable      Boolean   @default(true)
  created_at           DateTime? @db.Timestamp(0)
  updated_at           DateTime? @db.Timestamp(0)
  users                users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "user_profiles_user_id_foreign")

  @@index([country], map: "user_profiles_country_index")
  @@index([travel_style], map: "user_profiles_travel_style_index")
}

model users {
  id                                                          BigInt                   @id @default(autoincrement()) @db.UnsignedBigInt
  name                                                        String                   @db.VarChar(255)
  email                                                       String                   @unique(map: "users_email_unique") @db.VarChar(255)
  email_verified_at                                           DateTime?                @db.Timestamp(0)
  password                                                    String                   @db.VarChar(255)
  remember_token                                              String?                  @db.VarChar(100)
  created_at                                                  DateTime?                @db.Timestamp(0)
  updated_at                                                  DateTime?                @db.Timestamp(0)
  connection_requests_connection_requests_recipient_idTousers connection_requests[]    @relation("connection_requests_recipient_idTousers")
  connection_requests_connection_requests_requester_idTousers connection_requests[]    @relation("connection_requests_requester_idTousers")
  conversations_conversations_recipient_idTousers             conversations[]          @relation("conversations_recipient_idTousers")
  conversations_conversations_requester_idTousers             conversations[]          @relation("conversations_requester_idTousers")
  messages                                                    messages[]
  preferred_destinations                                      preferred_destinations[]
  travel_availabilities                                       travel_availabilities[]
  trip_join_requests                                          trip_join_requests[]
  trip_members                                                trip_members[]
  trips                                                       trips[]
  user_devices                                                user_devices[]
  user_interests                                              user_interests[]
  user_profiles                                               user_profiles?

  @@index([email_verified_at], map: "users_email_verified_at_index")
}
